{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true
  },
  "include": [
    "runtime.ts",
    "thread.ts",
    "store.ts",
    "loader.ts",
    "sandbox.ts",
    "hooks.ts",
    "contract.ts",
    "provider.ts",
    "files.ts",
    "util.ts",
    "cli.ts"
  ]
}
