{
  "suite": "code-execution",
  "about": "ThreadState.runCode conformance: isolation, modules, marshaling, limits, export resolution, erasure, event loop, and the section 14.9 checklist.",
  "cases": [
    {
      "id": "code-01-typescript-default-export",
      "agent": "probe",
      "requirements": [
        "S14.6-1",
        "S14.5-1",
        "S14.9-1",
        "S14.9-11"
      ],
      "why": "TypeScript is accepted by default, types are erased, and the default export value becomes the result.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"const n: number = 1 + 2;\\nexport default n;\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success",
            "result": 3
          }
        },
        {
          "kind": "status",
          "equals": "idle"
        }
      ]
    },
    {
      "id": "code-02-export-resolution",
      "agent": "probe",
      "requirements": [
        "S14.5-1",
        "S14.5-2",
        "S14.5-3",
        "S14.5-4"
      ],
      "why": "The selected export is called with args and awaited; missing, non-function with args, and throwing exports settle with their fixed statuses.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export function increment(n: number) { return n + 1; }\",\"options\":{\"execute\":{\"fn\":\"increment\",\"args\":[41]}}}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export const value = 1;\",\"options\":{\"execute\":{\"fn\":\"missing\"}}}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export const value = 1;\",\"options\":{\"execute\":{\"fn\":\"value\",\"args\":[1]}}}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export default () => { throw new Error(\\\"probe-throw\\\"); };\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success",
            "result": 42
          }
        },
        {
          "kind": "code",
          "index": 1,
          "equals": {
            "status": "link_error"
          }
        },
        {
          "kind": "code",
          "index": 2,
          "equals": {
            "status": "error"
          }
        },
        {
          "kind": "code",
          "index": 3,
          "equals": {
            "status": "error"
          }
        },
        {
          "kind": "code",
          "index": 3,
          "field": "error.message",
          "contains": "probe-throw"
        }
      ]
    },
    {
      "id": "code-03-module-resolution",
      "agent": "probe",
      "requirements": [
        "S14.2-1",
        "S14.2-2"
      ],
      "why": "Bare specifiers come only from imports, relatives only from modules, and URL or unknown specifiers fail linkage.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"import { x } from \\\"pkg\\\";\\nexport default x;\",\"options\":{\"imports\":{\"pkg\":{\"x\":7}}}}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"import { add } from \\\"./lib.js\\\";\\nexport default add(1, 2);\",\"options\":{\"modules\":{\"./lib.js\":\"export function add(a, b) { return a + b; }\"}}}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"const module = await import(\\\"https://example.com/probe.js\\\");\\nexport default 1;\"}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"import { x } from \\\"unknown-package\\\";\\nexport default x;\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success",
            "result": 7
          }
        },
        {
          "kind": "code",
          "index": 1,
          "equals": {
            "status": "success",
            "result": 3
          }
        },
        {
          "kind": "code",
          "index": 2,
          "equals": {
            "status": "link_error"
          }
        },
        {
          "kind": "code",
          "index": 3,
          "equals": {
            "status": "link_error"
          }
        }
      ]
    },
    {
      "id": "code-04-globals-and-isolation",
      "agent": "probe",
      "requirements": [
        "S14.1-1",
        "S14.1-2",
        "S14.1-3",
        "S14.1-4"
      ],
      "why": "Globals are module-scoped, globalThis holds only intrinsics, and mutations do not survive into the next call.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export default { onGlobal: typeof (globalThis as any).G, value: G, keys: Object.keys(globalThis).filter((key) => key === \\\"G\\\") };\",\"options\":{\"globals\":{\"G\":5}}}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"(globalThis as any).__leak = 1; (Object.prototype as any).hacked = true;\\nexport default \\\"mutated\\\";\"}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export default { leak: typeof (globalThis as any).__leak, hacked: ({} as any).hacked ?? null };\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success",
            "result": {
              "onGlobal": "undefined",
              "value": 5,
              "keys": []
            }
          }
        },
        {
          "kind": "code",
          "index": 1,
          "equals": {
            "status": "success",
            "result": "mutated"
          }
        },
        {
          "kind": "code",
          "index": 2,
          "equals": {
            "status": "success",
            "result": {
              "leak": "undefined",
              "hacked": null
            }
          }
        }
      ]
    },
    {
      "id": "code-05-forbidden-apis",
      "agent": "probe",
      "requirements": [
        "S14.1-5"
      ],
      "why": "eval, new Function, SharedArrayBuffer, and URL imports are all rejected rather than executed.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export default eval(\\\"1 + 1\\\");\"}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export default new Function(\\\"return 1\\\")();\"}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"const buffer = new SharedArrayBuffer(8);\\nexport default buffer.byteLength;\"}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"const module = await import(\\\"https://example.com/probe.js\\\");\\nexport default 1;\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "error"
          }
        },
        {
          "kind": "code",
          "index": 1,
          "equals": {
            "status": "error"
          }
        },
        {
          "kind": "code",
          "index": 2,
          "equals": {
            "status": "error"
          }
        },
        {
          "kind": "code",
          "index": 3,
          "equals": {
            "status": "link_error"
          }
        }
      ]
    },
    {
      "id": "code-06-value-marshaling",
      "agent": "probe",
      "requirements": [
        "S14.3-1",
        "S14.3-2",
        "S14.3-3"
      ],
      "why": "Structured values arrive as deep copies, host functions are callable proxies, and returned promises are awaited.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export default { map: [...new Map([[1, \\\"a\\\"]])], set: [...new Set([1, 2])], date: new Date(0).toISOString(), typed: Array.from(new Uint8Array([1, 2, 3])) };\"}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"import { double } from \\\"host\\\";\\nexport default await double(21);\",\"options\":{\"imports\":{\"host\":{}}}}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export default await Promise.resolve(9);\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success",
            "result": {
              "map": [
                [
                  1,
                  "a"
                ]
              ],
              "set": [
                1,
                2
              ],
              "date": "1970-01-01T00:00:00.000Z",
              "typed": [
                1,
                2,
                3
              ]
            }
          }
        },
        {
          "kind": "code",
          "index": 1,
          "equals": {
            "status": "success",
            "result": 42
          }
        },
        {
          "kind": "code",
          "index": 2,
          "equals": {
            "status": "success",
            "result": 9
          }
        }
      ]
    },
    {
      "id": "code-07-terminate",
      "agent": "probe",
      "requirements": [
        "S14.4-4",
        "S14.4-5",
        "S14.4-6"
      ],
      "why": "terminate() settles at a yield point with the caller reason; calling it twice is a no-op.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"while (true) { await Promise.resolve(); }\",\"terminateAfterMs\":50,\"terminateReason\":\"probe-terminate\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "terminated"
          }
        },
        {
          "kind": "code",
          "index": 0,
          "field": "error.message",
          "contains": "probe-terminate"
        }
      ]
    },
    {
      "id": "code-08-memory-limit",
      "agent": "probe",
      "requirements": [
        "S14.4-1"
      ],
      "why": "When the engine accounts heap, a small memoryLimitBytes settles the handle with status memory.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"const block = new Array(8 * 1024 * 1024).fill(1);\\nexport default block.length;\",\"options\":{\"memoryLimitBytes\":1048576}}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "memory"
          }
        }
      ]
    },
    {
      "id": "code-09-console-logs",
      "agent": "probe",
      "requirements": [
        "S14.9-S1"
      ],
      "why": "SHOULD: console output is captured into result.logs when no console global is supplied.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"console.log(\\\"probe-log\\\");\\nexport default 1;\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success",
            "result": 1
          }
        },
        {
          "kind": "code",
          "index": 0,
          "field": "logs.0.args",
          "contains": [
            "probe-log"
          ]
        }
      ]
    },
    {
      "id": "code-10-syntax-location",
      "agent": "probe",
      "requirements": [
        "S14.9-S2"
      ],
      "why": "SHOULD: a syntactic error carries line/column pointing at the caller source.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"const x: = 1;\\nexport default x;\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "error"
          }
        },
        {
          "kind": "code",
          "index": 0,
          "field": "error.line",
          "equals": 1
        }
      ]
    },
    {
      "id": "code-11-no-wall-clock-timeout",
      "agent": "probe",
      "requirements": [
        "S14.4-8"
      ],
      "why": "A 300 ms synchronous computation is not killed: runtimes must not invent a silent wall-clock timeout.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"const end = Date.now() + 300;\\nwhile (Date.now() < end) {}\\nexport default \\\"finished\\\";\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success",
            "result": "finished"
          }
        }
      ]
    },
    {
      "id": "code-12-top-level-await",
      "agent": "probe",
      "requirements": [
        "S14.7-1",
        "S14.7-3"
      ],
      "why": "Top-level await completes and the module result is available afterwards.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"const value = await Promise.resolve(11);\\nexport default value;\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success",
            "result": 11
          }
        }
      ]
    },
    {
      "id": "code-13-timers",
      "agent": "probe",
      "requirements": [
        "S14.7-2",
        "S14.1-2",
        "S14.1-3"
      ],
      "why": "setTimeout is absent by default and becomes a module-scope binding when bridged through globals.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export default typeof setTimeout;\"}]]"
        },
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export default typeof setTimeout;\",\"options\":{\"globals\":{}}}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success",
            "result": "undefined"
          }
        },
        {
          "kind": "code",
          "index": 1,
          "equals": {
            "status": "success",
            "result": "function"
          }
        }
      ]
    },
    {
      "id": "code-14-import-meta-url",
      "agent": "probe",
      "requirements": [
        "S14.2-3"
      ],
      "why": "import.meta.url is synthetic and never a host path.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"export default import.meta.url;\"}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success"
          }
        },
        {
          "kind": "code",
          "index": 0,
          "field": "result",
          "contains": "sandbox:"
        }
      ]
    },
    {
      "id": "code-15-bridged-function-boundary",
      "agent": "probe",
      "requirements": [
        "S14.3-5"
      ],
      "why": "A bridged host function sees only its explicit arguments: the sandbox cannot reach a host receiver.",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"import { read } from \\\"host\\\";\\nexport default read.call({ stolen: true });\",\"options\":{\"imports\":{\"host\":{}}}}]]"
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "success",
            "result": "no-this"
          }
        }
      ]
    },
    {
      "id": "code-16-abort-signal",
      "agent": "probe",
      "requirements": [
        "S14.9-S3"
      ],
      "why": "SHOULD: thread termination aborts in-flight runCode by calling handle.terminate().",
      "ops": [
        {
          "send": "[[once]][[tool:run_code {\"source\":\"while (true) { await Promise.resolve(); }\"}]]",
          "async": true
        },
        {
          "sleep": {
            "ms": 100
          }
        },
        {
          "terminate": true
        },
        {
          "settle": true
        }
      ],
      "expect": [
        {
          "kind": "code",
          "index": 0,
          "equals": {
            "status": "terminated"
          }
        },
        {
          "kind": "terminated",
          "notEquals": null
        }
      ]
    }
  ]
}
